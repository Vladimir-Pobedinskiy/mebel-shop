{
	"name": "mebel-shop",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "nuxt build",
		"dev": "nuxt dev",
		"server": "json-server --watch db.json --routes routes.json --port 3001",
		"double": "concurrently \"npm run dev\" \"npm run server\"",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"lint": "eslint \"**/*.{js,ts,vue}\" && stylelint \"**/*.{css,scss,vue}\"",
		"lint:styles": "stylelint \"**/*.{css,scss,vue}\"",
		"lint:styles:fix": "stylelint \"**/*.{css,scss,vue}\" --fix",
		"lint:scripts": "eslint \"**/*.{js,ts,vue}\"",
		"lint:scripts:fix": "eslint \"**/*.{js,ts,vue}\" --fix",
		"format": "prettier --check \"**/*.{js,ts,vue,css,scss,json,md}\"",
		"format:fix": "prettier --write \"**/*.{js,ts,vue,css,scss,json,md}\"",
		"prepare": "husky"
	},
	"dependencies": {
		"@formkit/auto-animate": "^0.9.0",
		"@headlessui/vue": "^1.7.23",
		"@hypernym/nuxt-gsap": "^2.4.3",
		"@nuxt/image": "^2.1.0",
		"@nuxtjs/robots": "^6.2.0",
		"@nuxtjs/sitemap": "^8.5.0",
		"@pinia/nuxt": "^1.0.2",
		"@sidebase/nuxt-auth": "^1.3.1",
		"@vueuse/core": "^14.4.0",
		"glightbox": "^3.3.1",
		"normalize.css": "^8.0.1",
		"nuxt": "^4.5.2",
		"nuxt-icons": "^4.0.0",
		"nuxt-schema-org": "^6.3.1",
		"pinia": "^4.0.3",
		"swiper": "^14.2.0",
		"typograf": "^7.8.0",
		"vee-validate": "^4.15.1",
		"vue": "^3.5.42",
		"vue-final-modal": "^4.5.5",
		"vue-imask": "^7.6.1",
		"vue-multiselect": "^3.5.0",
		"vue-router": "^5.3.1",
		"vue-yandex-maps": "^3.0.4",
		"vue3-marquee": "^4.2.2",
		"yup": "^1.7.1"
	},
	"devDependencies": {
		"@nuxt/eslint": "^1.17.0",
		"@types/eslint-config-prettier": "^6.11.3",
		"@types/node": "^26.4.1",
		"concurrently": "^10.0.5",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.4",
		"husky": "^9.1.7",
		"json-server": "^0.17.4",
		"lint-staged": "^17.4.1",
		"postcss-html": "^2.0.0",
		"postcss-scss": "^4.0.9",
		"prettier": "^3.9.6",
		"sass": "^1.103.1",
		"sass-loader": "^17.0.1",
		"stylelint": "^17.14.1",
		"stylelint-config-html": "^2.0.0",
		"stylelint-config-recess-order": "^7.8.0",
		"stylelint-config-recommended-vue": "^2.0.0",
		"stylelint-config-standard": "^40.0.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"stylelint-order": "^8.1.1",
		"stylelint-prettier": "^5.0.3",
		"typescript": "~6.0.3",
		"vite-plugin-checker": "^0.14.5",
		"vue-tsc": "^3.3.11"
	},
	"lint-staged": {
		"*.{js,ts,vue}": "eslint --fix",
		"*.{css,scss,vue}": "stylelint --fix",
		"*.{js,ts,vue,css,scss,json,md}": "prettier --write"
	}
}
